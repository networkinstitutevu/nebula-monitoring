// --- Loki Write Destination ---
loki.write "loki_backend" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// --- JOB 1: Host System Logs ---
local.file_match "system_logs" {
  path_targets = [{
    "__path__" = "/var/log/*log",
    "job"      = "system-logs",
    "host"     = sys.env("HOSTNAME"),
  }]
}

loki.source.file "system_logs" {
  targets    = local.file_match.system_logs.targets
  forward_to = [loki.write.loki_backend.receiver]
}

// --- JOB 2: Docker Container Logs ---
discovery.docker "docker_containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "15s"
}

discovery.relabel "docker_logs" {
  targets = discovery.docker.docker_containers.targets

  // 1. Set host label
  rule {
    target_label = "host"
    replacement  = sys.env("HOSTNAME")
  }

  // 2. Set 'container' label (strip leading slash)
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/?(.*)"
    target_label  = "container"
  }

  // 3. Fallback: Set 'service' to container name by default
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/?(.*)"
    target_label  = "service"
  }

  // 4. If Docker Compose service exists (non-empty), override 'service'
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "(.+)"
    target_label  = "service"
  }

  // 5. If 'service_name' exists (non-empty), override 'service' with it
  rule {
    source_labels = ["service_name"]
    regex         = "(.+)"
    target_label  = "service"
  }

  // 6. Drop 'service_name' label so only 'service' is exported
  rule {
    regex  = "service_name"
    action = "labeldrop"
  }

  // 7. Label log with image name
  rule {
    source_labels = ["__meta_docker_container_image"]
    target_label  = "image"
  }
}

loki.process "docker_pipeline" {
  // Parse standard Docker JSON wrapper
  stage.json {
    expressions = {
      output = "log",
      stream = "stream",
      time   = "time",
    }
  }

  stage.timestamp {
    format = "RFC3339"
    source = "time"
  }

  stage.output {
    source = "output"
  }

  forward_to = [loki.write.loki_backend.receiver]
}

loki.source.docker "docker_logs" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.docker_logs.output
  forward_to = [loki.process.docker_pipeline.receiver]
}
